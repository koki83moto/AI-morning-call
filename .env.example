# このファイルを .env にコピーして値を埋めてください。
# .env は .gitignore 済みなのでコミットされません。

# --- Twilio ---------------------------------------------------------------
# https://console.twilio.com のダッシュボードに表示されています
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio で購入した電話番号（E.164 形式）
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# --- Anthropic ------------------------------------------------------------
# https://console.anthropic.com/settings/keys で発行
ANTHROPIC_API_KEY=
# 既定は Haiku 4.5。精度が足りなければ claude-sonnet-5 に変更してください。
ANTHROPIC_MODEL=claude-haiku-4-5

# --- アプリ ---------------------------------------------------------------
# Twilio の Webhook が到達できる公開 URL。末尾のスラッシュは不要。
# ローカル開発では ngrok の https URL を貼ります（例: https://xxxx-xx.ngrok-free.app）
APP_BASE_URL=

# 管理 API を守る固定キー。適当な長いランダム文字列を入れてください。
# 例: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

TIMEZONE=Asia/Tokyo
DEFAULT_MESSAGE=おはようございます。起きる時間ですよ。

# --- 再架電の挙動 ---------------------------------------------------------
SNOOZE_MINUTES=5
MAX_RETRIES=3

# --- ConversationRelay ----------------------------------------------------
# 無音が何秒続いたら反応がないとみなすか／何回続いたら諦めるか
SILENCE_TIMEOUT_SECONDS=15
MAX_SILENCE_STRIKES=2
# 1通話あたりの最大やり取り回数
MAX_TURNS=8

# 音声の指定（空なら Twilio の既定に任せる）
# 例: TWILIO_TTS_PROVIDER=Google / TWILIO_VOICE=ja-JP-Neural2-B
TWILIO_TTS_PROVIDER=
TWILIO_VOICE=

# Twilio Webhook の署名検証。URL 不一致などで検証が通らないときだけ false に。
TWILIO_VALIDATE_SIGNATURE=true

# --- DB -------------------------------------------------------------------
# 未設定ならリポジトリ直下の morning_call.db を使います
# DATABASE_URL=sqlite:///./morning_call.db
