# このファイルを .env にコピーして値を埋めてください。
# .env は .gitignore 済みなのでコミットされません。

# --- Telnyx ---------------------------------------------------------------
# Mission Control Portal → API Keys で発行
TELNYX_API_KEY=
# 任意。ポータルに表示されない場合は空のままで構わない
# （空なら /v2/texml/calls/{application_id} 形式で発信する）
TELNYX_ACCOUNT_SID=
# Voice → TeXML Applications で作成したアプリの ID
TELNYX_APPLICATION_SID=
# Telnyx で購入した電話番号（E.164 形式）
TELNYX_PHONE_NUMBER=+1XXXXXXXXXX

# ConversationRelay の言語・音声設定
TELNYX_LANGUAGE=ja-JP
# 文字起こしの提供元とモデル。Deepgram の flux は英語専用なので日本語では nova-3 を使う。
TELNYX_TRANSCRIPTION_PROVIDER=deepgram
TELNYX_SPEECH_MODEL=nova-3
# 読み上げ音声。空にすると英語音声で読まれるので日本語の音声 ID を必ず指定する。
# 他の候補: AWS.Polly.Takumi-Neural(男性) / AWS.Polly.Kazuha-Neural / Azure.ja-JP-NanamiNeural
# 一覧: GET https://api.telnyx.com/v2/text-to-speech/voices
TELNYX_TTS_PROVIDER=
TELNYX_VOICE=AWS.Polly.Tomoko-Neural

# ConversationRelay(v2) 用の音声。<Say> とは別系統で、Telnyx ホスト音声(Telnyx.*)が確実。
# 空なら TELNYX_VOICE を流用します。
TELNYX_RELAY_VOICE=Telnyx.Ultra.2b568345-1d48-4047-b25f-7baccf842eb0

# Webhook の Ed25519 署名検証。既定は無効（通話ごとのトークンで保護される）。
# 有効にする場合は Keys & Credentials → Public Key の値を入れて true にする。
TELNYX_PUBLIC_KEY=
TELNYX_VALIDATE_SIGNATURE=false

# --- Anthropic ------------------------------------------------------------
# https://console.anthropic.com/settings/keys で発行
ANTHROPIC_API_KEY=
# 既定は Haiku 4.5。精度が足りなければ claude-sonnet-5 に変更してください。
ANTHROPIC_MODEL=claude-haiku-4-5

# --- アプリ ---------------------------------------------------------------
# Telnyx の Webhook が到達できる公開 URL。末尾のスラッシュは不要。
# ローカル開発では ngrok の https URL を貼ります（例: https://xxxx-xx.ngrok-free.dev）
APP_BASE_URL=

# 管理 API を守る固定キー。UI のログインパスワードも兼ねます。
# 適当な長いランダム文字列を入れてください。
# 例: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ※ 変更すると発行済みのログイン Cookie はすべて無効になります。
API_KEY=

# ログイン状態を保持する秒数（既定 30 日）
SESSION_TTL_SECONDS=2592000

TIMEZONE=Asia/Tokyo
DEFAULT_MESSAGE=おはようございます。起きる時間ですよ。

# --- 再架電の挙動 ---------------------------------------------------------
SNOOZE_MINUTES=5
MAX_RETRIES=3

# --- ConversationRelay ----------------------------------------------------
# 無音が何秒続いたら反応がないとみなすか／何回続いたら諦めるか
SILENCE_TIMEOUT_SECONDS=15
MAX_SILENCE_STRIKES=2
# 1通話あたりの最大やり取り回数
MAX_TURNS=8

# --- DB -------------------------------------------------------------------
# 未設定ならリポジトリ直下の morning_call.db を使います
# DATABASE_URL=sqlite:///./morning_call.db
